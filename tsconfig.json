{
  "compilerOptions": {
    "target": "ES2020",                  // compile down to ES2020 JavaScript
    "lib": ["dom", "dom.iterable", "esnext"], // browser + latest JS built-in types
    "allowJs": true,                     // allow importing .js files alongside .ts
    "skipLibCheck": true,                // skip type-checking inside node_modules
    "strict": true,                      // enable all strict type checks
    "noEmit": true,                      // don't output .js files — Next.js handles that
    "esModuleInterop": true,             // allow default imports from CommonJS packages
    "module": "esnext",                  // use ESNext import/export syntax
    "moduleResolution": "bundler",       // resolve modules the same way Next.js does
    "resolveJsonModule": true,           // allow importing .json files
    "isolatedModules": true,             // each file must be independently compilable
    "jsx": "react-jsx",                  // modern JSX transform — no need to import React
    "incremental": true,                 // cache compilation info for faster rebuilds
    "plugins": [{ "name": "next" }],     // Next.js editor plugin for better autocomplete
    "paths": { "@/*": ["./src/*"] },     // @/ maps to src/ for clean imports
    "experimentalDecorators": true,      // enable @Decorator syntax
    "emitDecoratorMetadata": true,       // emit type metadata for DI containers
    "forceConsistentCasingInFileNames": true, // prevent import casing bugs on Windows
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,  // error on accidental switch case fall-through
    "noImplicitReturns": true,           // error if a function can exit without returning
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",                     // auto-generated by Next.js — provides page/image types
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",                      // never type-check third-party packages
    ".next"                              // Next.js build output
  ]
}
