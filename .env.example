# Application Configuration
NEXT_PUBLIC_APP_NAME=D3NTIQ
NEXT_PUBLIC_APP_ENV=development

# API Configuration
# Points to the NestJS backend (port 4000 in local dev, your backend URL in production)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_API_VERSION=v1

# Feature Flags
NEXT_PUBLIC_ENABLE_3D_VIEWER=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Authentication (if using external auth service)
# NEXT_PUBLIC_AUTH_URL=
# NEXT_PUBLIC_AUTH_CLIENT_ID=

# Third-party Services (placeholders)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ANALYTICS_ID=

# Playwright Test Configuration
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000